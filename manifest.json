{
  "manifest_version": 3,
  "name": "WA Media Downloader",
  "version": "1.4",
  "default_locale": "en",
  "description": "Bulk download media from the current WhatsApp Web chat.",
  "permissions": [
    "downloads",
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "lib/zip-packager.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wa-media-downloader@madderose",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
